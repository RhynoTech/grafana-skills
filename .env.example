# ============================================================================
#  grafana-tools configuration
#  Repo checkout:  cp .env.example .env            (gitignored)
#  Plugin install: cp .env.example ~/.config/grafana-tools/.env
#                  (survives plugin updates; checked when no .env sits
#                  beside the scripts)
#  Real shell environment variables always override anything set here.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
#  1. Quick start — a single Grafana instance
#  Set a base URL and ONE credential. That's enough to run.
# ─────────────────────────────────────────────────────────────────────────

GRAFANA_BASE_URL=https://grafana.example.com

# Auth: a token is preferred (non-interactive). Use a cookie only if you can't
# mint a token. Provide exactly one.
GRAFANA_TOKEN=glsa_replace_me
# GRAFANA_COOKIE=_oauth2_proxy=...; other_cookie=...

# ─────────────────────────────────────────────────────────────────────────
#  2. Multiple instances (optional)
#  Define named environments with a GRAFANA_<NAME>_ prefix, then choose one
#  per command with GRAFANA_ENV=<name>:
#
#      GRAFANA_ENV=staging ./promql.sh 'up'
#
#  The active env is GRAFANA_ENV -> GRAFANA_DEFAULT_ENV -> "prod". A prefixed
#  value overrides the unprefixed quick-start value above for that env.
# ─────────────────────────────────────────────────────────────────────────

# GRAFANA_DEFAULT_ENV=prod

# GRAFANA_PROD_BASE_URL=https://grafana.example.com
# GRAFANA_PROD_TOKEN=glsa_replace_me
# GRAFANA_PROD_COOKIE=_oauth2_proxy=...

# GRAFANA_STAGING_BASE_URL=https://grafana.staging.example.com
# GRAFANA_STAGING_TOKEN=glsa_replace_me
# GRAFANA_STAGING_COOKIE=_oauth2_proxy=...

# ─────────────────────────────────────────────────────────────────────────
#  3. Advanced (rarely needed)
# ─────────────────────────────────────────────────────────────────────────

# Datasource UIDs, if yours aren't the Grafana defaults. Prefix per-env
# (GRAFANA_STAGING_PROMETHEUS_UID=...) if they differ between instances.
# GRAFANA_PROMETHEUS_UID=prometheus
# GRAFANA_LOKI_UID=loki

# Load a .env from an explicit path, overriding the default lookup
# (.env beside the scripts, then ~/.config/grafana-tools/.env). Set to
# /dev/null to disable .env loading entirely.
# GRAFANA_QUERY_ENV_FILE=/some/other/path/.env
